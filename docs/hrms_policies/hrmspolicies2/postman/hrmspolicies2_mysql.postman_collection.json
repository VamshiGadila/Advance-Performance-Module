{
  "info": {
    "name": "HRMS Policies 2 - MySQL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "policyId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Test User\", \"email\": \"testuser@example.com\", \"password\": \"Password@123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@gmail.com\", \"password\": \"admin123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Policies CRUD",
      "item": [
        {
          "name": "Get All Policies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies"
              ]
            }
          }
        },
        {
          "name": "Get Policy By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "{{policyId}}"
              ]
            }
          }
        },
        {
          "name": "Create Policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Leave Policy\", \"code\": \"POL-LEAVE-001\", \"category\": \"Leave\", \"content\": \"Employees are entitled to annual leave according to company policy.\", \"applicability\": \"ALL\", \"mandatory\": true, \"status\": \"DRAFT\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies"
              ]
            }
          }
        },
        {
          "name": "Update Policy PUT",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Updated Leave Policy\", \"code\": \"POL-LEAVE-001\", \"category\": \"Leave\", \"content\": \"Updated policy content.\", \"applicability\": \"ALL\", \"mandatory\": true, \"status\": \"DRAFT\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "{{policyId}}"
              ]
            }
          }
        },
        {
          "name": "Update Policy PATCH",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\": \"Partially updated policy content.\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "{{policyId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Policy",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/{{policyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "{{policyId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Password",
      "item": [
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@gmail.com\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@gmail.com\", \"newPassword\": \"Password@123\", \"confirmPassword\": \"Password@123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "reset-password"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Policies - Advanced Search",
      "item": [
        {
          "name": "Search - keyword only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/search?keyword=leave",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "search"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": "leave"
                }
              ]
            }
          }
        },
        {
          "name": "Search - filter by category + status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/search?category=Leave&status=ACTIVE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "search"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Leave"
                },
                {
                  "key": "status",
                  "value": "ACTIVE"
                }
              ]
            }
          }
        },
        {
          "name": "Search - mandatory policies only, sorted by name desc",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/search?mandatory=true&sortBy=name&direction=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "search"
              ],
              "query": [
                {
                  "key": "mandatory",
                  "value": "true"
                },
                {
                  "key": "sortBy",
                  "value": "name"
                },
                {
                  "key": "direction",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Search - pagination (page 1, size 5)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/search?page=1&size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "search"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Search - combined filters + sorting + pagination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/search?keyword=policy&category=Leave&applicability=ALL&page=0&size=10&sortBy=createdAt&direction=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "search"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": "policy"
                },
                {
                  "key": "category",
                  "value": "Leave"
                },
                {
                  "key": "applicability",
                  "value": "ALL"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt"
                },
                {
                  "key": "direction",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Search - negative: invalid sortBy field (expect 400)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/search?sortBy=notAField",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "search"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "notAField"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Negative Scenarios",
      "item": [
        {
          "name": "Get Policy By ID - not found (expect 404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/policies/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies",
                "999999"
              ]
            }
          }
        },
        {
          "name": "Create Policy - missing required fields (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"category\": \"Leave\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies"
              ]
            }
          }
        },
        {
          "name": "Create Policy - duplicate code (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Duplicate Policy\", \"code\": \"WFH-001\", \"category\": \"Leave\", \"content\": \"...\", \"applicability\": \"ALL\", \"mandatory\": true, \"status\": \"DRAFT\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies"
              ]
            }
          }
        },
        {
          "name": "Login - invalid credentials (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@gmail.com\", \"password\": \"wrongpassword\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get All Policies - no token (expect 401/403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "policies"
              ]
            }
          }
        }
      ]
    }
  ]
}