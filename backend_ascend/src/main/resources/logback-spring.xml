<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <property name="LOG_DIR" value="${LOG_PATH:-logs}" />
    <property name="APP_NAME" value="ascend-performance" />

    <!-- ========================================================================= -->
    <!-- Console Appender with Color Formatting & Correlation ID                   -->
    <!-- ========================================================================= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %magenta([%X{correlationId:-NO-TRACE}]) %yellow([%thread]) %cyan(%logger{36}) : %msg%n%throwable</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========================================================================= -->
    <!-- Spring Profile Configurations                                             -->
    <!-- ========================================================================= -->

    <!-- DEV / LOCAL Profile -->
    <springProfile name="dev,local,default">
        <appender name="DEV_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/ascend-dev.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archived/ascend-dev-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{correlationId:-NO-TRACE}] [ip=%X{clientIp:-N/A}] [%thread] %logger{36} - %msg%n%throwable</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <logger name="com.practice.springbootdemo.advance_performance_module" level="DEBUG" />
        <logger name="org.springframework.security" level="INFO" />
        <logger name="org.hibernate.SQL" level="DEBUG" />
        <logger name="org.hibernate.type.descriptor.sql" level="TRACE" />
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="DEV_FILE" />
        </root>
    </springProfile>

    <!-- PROD Profile -->
    <springProfile name="prod">
        <appender name="PROD_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/ascend-prod.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archived/ascend-prod-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>60</maxHistory>
                <totalSizeCap>5GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{correlationId:-NO-TRACE}] [ip=%X{clientIp:-N/A}] [%thread] %logger{40} - %msg%n%throwable</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="ASYNC_PROD_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="PROD_FILE" />
            <queueSize>1024</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>false</includeCallerData>
        </appender>

        <logger name="com.practice.springbootdemo.advance_performance_module" level="INFO" />
        <logger name="org.springframework.security" level="WARN" />
        <logger name="org.hibernate" level="WARN" />
        <root level="WARN">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="ASYNC_PROD_FILE" />
        </root>
    </springProfile>

    <!-- TEST Profile -->
    <springProfile name="test">
        <logger name="com.practice.springbootdemo.advance_performance_module" level="INFO" />
        <logger name="org.springframework.security" level="WARN" />
        <root level="WARN">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

</configuration>
